rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read: if true;

      allow create: if isValidOrderCreate(request.resource.data);
      allow update: if isValidOrderUpdate(request.resource.data);
    }



    match /amenity_orders/{amenityId} {
      allow read: if true;

      allow create: if isValidAmenityCreate(request.resource.data);
      allow update: if isValidAmenityUpdate(request.resource.data);
    }

    match /menu_master/{menuId} {
      allow read: if true;
      allow create, update: if true;
    }

    match /ocr_alias/{aliasId} {
      allow read: if true;
      allow create, update: if true;
    }


    function isValidAmenityCreate(data) {
      return isValidAmenityData(data);
    }

    function isValidAmenityUpdate(data) {
      return isValidAmenityData(data);
    }

    function isValidAmenityData(data) {
      return data.keys().hasOnly([
        'itemType',
        'itemLabel',
        'otherText',
        'serviceDate',
        'serviceTime',
        'serviceAtMs',
        'receiverName',
        'senderName',
        'notes',
        'photoUrl',
        'photoStatus',
        'status',
        'alertAcknowledged',
        'alertAcknowledgedAtMs',
        'alertStartedAtMs',
        'completed',
        'softDeleted',
        'createdAt',
        'updatedAt',
        'createdAtMs',
        'completedAtMs'
      ])
      && data.itemType is string
      && data.itemLabel is string
      && data.otherText is string
      && data.serviceDate is string
      && data.serviceTime is string
      && data.serviceAtMs is int
      && data.receiverName is string
      && data.senderName is string
      && data.notes is string
      && data.photoUrl is string
      && data.photoStatus is string
      && data.status is string
      && data.alertAcknowledged is bool
      && data.alertAcknowledgedAtMs is int
      && data.alertStartedAtMs is int
      && data.completed is bool
      && data.softDeleted is bool
      && data.createdAtMs is int
      && data.completedAtMs is int;
    }

    function isValidOrderCreate(data) {
      return data.keys().hasOnly([
        'billNo',
        'tableNo',
        'hostessName',
        'guestName',
        'notes',
        'imageUrl',
        'rawText',
        'readingText',
        'items',
        'ocrStatus',
        'completed',
        'softDeleted',
        'createdAt',
        'updatedAt',
        'createdAtMs',
        'completedAtMs',
        'completionDurationMs',
        'exceeded30m',
        'exceeded30mAtMs',
        'alertPhrase'
      ])
      && data.createdAtMs is int
      && data.completedAtMs is int
      && data.completionDurationMs is int
      && data.exceeded30m is bool
      && data.exceeded30mAtMs is int
      && data.completed is bool
      && data.softDeleted is bool
      && data.billNo is string
      && data.tableNo is string
      && data.hostessName is string
      && data.guestName is string
      && data.notes is string
      && data.rawText is string
      && data.readingText is string
      && data.ocrStatus is string
      && data.alertPhrase is string
      && data.items is list;
    }

    function isValidOrderUpdate(data) {
      return data.keys().hasOnly([
        'billNo',
        'tableNo',
        'hostessName',
        'guestName',
        'notes',
        'imageUrl',
        'rawText',
        'readingText',
        'items',
        'ocrStatus',
        'completed',
        'softDeleted',
        'createdAt',
        'updatedAt',
        'createdAtMs',
        'completedAtMs',
        'completionDurationMs',
        'exceeded30m',
        'exceeded30mAtMs',
        'alertPhrase'
      ])
      && data.createdAtMs is int
      && data.completedAtMs is int
      && data.completionDurationMs is int
      && data.exceeded30m is bool
      && data.exceeded30mAtMs is int
      && data.completed is bool
      && data.softDeleted is bool
      && data.billNo is string
      && data.tableNo is string
      && data.hostessName is string
      && data.guestName is string
      && data.notes is string
      && data.rawText is string
      && data.readingText is string
      && data.ocrStatus is string
      && data.alertPhrase is string
      && data.items is list;
    }
  }
}
